# WALLFRUITS - EXEMPLO DE CONFIGURACAO
# Copie para .env e ajuste os valores

# Banco de dados (use a URL do Supabase, preferencialmente do Pooler)
# Exemplo: postgresql://postgres.xxxxx:[SENHA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
STARTUP_DB_RETRIES=5
STARTUP_DB_RETRY_DELAY_SECONDS=2
STRICT_STARTUP=false
HEALTHCHECK_TIMEOUT_SECONDS=3

# Supabase Auth (habilite para usar login/registro via Supabase)
SUPABASE_AUTH_ENABLED=false
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=cole_aqui_sua_anon_key
# Opcional, mas recomendado para criar usuarios pelo backend sem confirmacao de email
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_sua_service_role_key

# Supabase Storage (media/CDN)
# Quando habilitado, uploads de imagens vão para o bucket e os clientes podem consumir via URL pública (CDN).
SUPABASE_STORAGE_ENABLED=false
SUPABASE_STORAGE_BUCKET=cole_aqui_o_nome_do_bucket_publico
# Opcional: base pública (ex.: https://cdn.seudominio.com). Se vazio, usa SUPABASE_URL.
SUPABASE_STORAGE_PUBLIC_BASE_URL=
# Timeout de rede (segundos) para operações Storage.
SUPABASE_STORAGE_TIMEOUT_SECONDS=20

# Seguranca (GERE UMA CHAVE FORTE!)
SECRET_KEY=cole_aqui_uma_chave_secreta_longa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_TITLE=WallFruits API
API_DESCRIPTION=Marketplace inteligente de frutas
API_VERSION=2.0.0
DEBUG=false

# CORS / Hosts (ajuste com seu dominio Render)
CORS_ORIGINS=["https://seu-app.onrender.com"]
ALLOWED_HOSTS=["seu-app.onrender.com"]

# Redis (deixe false no plano gratis)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Workers de IA
AGENDA_PREDICTIVE_WORKER_ENABLED=true
AGENDA_PREDICTIVE_WORKER_INTERVAL_SECONDS=120
BUSINESS_OS_MARKETING_WORKER_ENABLED=true
BUSINESS_OS_MARKETING_WORKER_INTERVAL_SECONDS=600
BUSINESS_OS_MARKETING_WORKER_WINDOW_DAYS=7
BUSINESS_OS_MARKETING_WORKER_MIN_SEGMENT_SIGNALS=3

# Webhook opcional para eventos de intermediação (validação/contrato)
INTERMEDIATION_WEBHOOK_URL=
INTERMEDIATION_WEBHOOK_TIMEOUT_SECONDS=5

# Upload e logs
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=10485760
MAX_CONTRACT_FILE_SIZE=15728640
ALLOWED_CONTRACT_EXTENSIONS=["pdf","doc","docx","png","jpg","jpeg"]
LOG_LEVEL=INFO

# Monetizacao (Ads)
WF_ADS_ENABLED=true
WF_ADS_PROVIDER=fallback
WF_ADSENSE_CLIENT=
WF_ADS_SLOT_TOP=
WF_ADS_SLOT_BOTTOM=
WF_ADS_SCRIPT_URL=
WF_ADS_EXPERIMENT_ENABLED=true
WF_ADS_EXPERIMENT_ROLLOUT=1.0
WF_ADS_EXPERIMENT_VARIANTS=["a","b"]
WF_ADS_SESSION_CAP_PER_SLOT=5
WF_ADS_DAILY_CAP_PER_SLOT=22
WF_ADS_FATIGUE_NO_CLICK_THRESHOLD=10
WF_ADS_FATIGUE_HARD_THRESHOLD=18
